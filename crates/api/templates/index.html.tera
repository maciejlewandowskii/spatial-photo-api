{% extends "layout" %}

{% block content %}
<div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
    <h1 class="text-2xl font-bold mb-6 text-center">Login</h1>
    
    <form hx-post="/login" hx-target="#error-msg" hx-swap="innerHTML">
        <div class="mb-4">
            <label class="block text-gray-700 mb-2" for="email">Email</label>
            <input class="w-full p-2 border rounded" type="email" id="email" name="email" required>
        </div>
        <div class="mb-6">
            <label class="block text-gray-700 mb-2" for="password">Password</label>
            <input class="w-full p-2 border rounded" type="password" id="password" name="password" required>
        </div>
        <div id="error-msg" class="text-red-500 mb-4"></div>
        <button class="w-full bg-blue-600 text-white p-2 rounded hover:bg-blue-700 font-bold" type="submit">
            Sign In
        </button>
    </form>
    
    <p class="mt-4 text-center text-gray-600">
        Don't have an account? <a href="/register" class="text-blue-600">Register</a>
    </p>
</div>
{% endblock %}
